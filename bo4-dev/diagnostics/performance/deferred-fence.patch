+void Rasterizer::DeferFence(Common::UniqueFunction<void> signal) {
+    if (!texture_cache.QueueDownloadImages() && pending_fences == 0) {
+        signal();
+        return;
+    }
+    ++pending_fences;
+    pending_fence_tick = scheduler.CurrentTick();
+    scheduler.DeferOperation([this, signal = std::move(signal)] {
+        signal();
+        --pending_fences;
+    });
+    scheduler.Flush();
+}
+
+void Rasterizer::FinishPendingFences() {
+    if (pending_fences != 0) {
+        scheduler.Wait(pending_fence_tick);
+        scheduler.PopPendingOperations();
+    }
+}
+
+void Rasterizer::PollPendingFences() {
+    if (pending_fences != 0) {
+        scheduler.PopPendingOperations();
+    }
